# Reference only. Server reads real environment variables; none are required.
# scripts/run.sh and scripts/run.ps1 load .env (if present) before starting.
# HOST=0.0.0.0                 # 127.0.0.1 = this machine only
# PORT=8080
# ALLOWED_ORIGINS=             # extra origins, comma separated, e.g. http://game.lan:8080
# ADMIN_TOKEN=                 # >=16 chars; enables GET /admin/stats with Bearer auth
# MAX_CONN_PER_IP=8
